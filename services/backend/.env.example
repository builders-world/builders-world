# gateway
BIND_ADDR=0.0.0.0:8080   # or set PORT (Railway does)

# gateway, jobs (matches deploy/docker-compose.yml when run from the host)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/open_world
REDIS_URL=redis://localhost:6379

# gateway (all optional)
# Sign in with GitHub. Create an OAuth app (GitHub > Settings > Developer settings > OAuth Apps) with the callback URL
# <PUBLIC_URL>/api/auth/github/callback and put its id and secret here. PUBLIC_URL is this gateway's own public address.
# Without all three nobody can sign in, and the game is played solo. ALLOWED_ORIGINS (below) says where people may be sent back to.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# PUBLIC_URL=https://api.example.com
# When the game's own address forwards /api to the gateway (vercel.json in the game repo), GitHub can send people back there
# instead: register that address as the callback and set it here. Unset, the callback is <PUBLIC_URL>/api/auth/github/callback.
# GITHUB_REDIRECT_URL=https://buildersworld.vercel.app/api/auth/oauth/github/callback
# A read-only GitHub token, no scopes needed. With it commits are counted exactly; without it the public contribution calendar is
# read, which also counts pull requests and issues.
# GITHUB_TOKEN=ghp_xxx
# Where the game is served from, comma-separated, no wildcard. Leave empty when the game and the API share one address
# (or the game's dev server proxies /api to this one).
# ALLOWED_ORIGINS=http://localhost:5173
# Requests one client address may send per minute. Presence is one a second per player and many players share an address.
# RATE_LIMIT_PER_MINUTE=1200
# Behind a proxy, say which header holds the true client address (x-real-ip on Railway) or how many proxies there are.
# CLIENT_IP_HEADER=x-real-ip
# TRUSTED_PROXY_HOPS=1
