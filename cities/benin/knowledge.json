  "names": {
    "order": "given family",
    "conventions": "Beninese people usually carry a French Christian first name (Romaric, Gildas, Prudence, Bénédicta) or a Muslim one, a Fon or Yoruba name, and a family name from the father. Many Fon names come from the circumstances of a birth: Dossou and Dossi for a boy or girl born after twins, Agossou for a baby born feet first, Zinsou and Zinhoué for twins. Names built on Sè or Mahou (God) are common: Sèdjro, Sènami, Mahougnon. Yoruba Muslim families of Cotonou and Porto-Novo carry names like Lawani and Yessoufou, and their daughters' names often end in -ath: Latifath, Rafiath, Sikirath.",
    "groups": {
      "fon": {
        "given": {
          "m": ["Sèdjro", "Sènan", "Mahougnon", "Houénou", "Dossou", "Agossou", "Zinsou", "Codjo", "Comlan", "Sossa", "Kpossi", "Gbènou"],
          "f": ["Fifamè", "Sènami", "Houéfa", "Dossi", "Zinhoué", "Sèna", "Mahoussi", "Ayaba", "Ablawa", "Gnona", "Sèdami", "Hounsi"]
        },
        "family": ["Dossou", "Zinsou", "Agossou", "Gbaguidi", "Hounkpatin", "Adjovi", "Tossou", "Sossou", "Houessou", "Ahouansou", "Hounsou", "Kpadonou", "Akpovi", "Hounnou", "Agbangla", "Dossou-Yovo", "Ahouandjinou", "Gnonlonfoun"],
        "also": { "m": ["Romaric", "Gildas", "Rodrigue", "Ghislain", "Wilfried", "Hermann", "Fortuné", "Parfait", "Ulrich", "Arnaud"], "f": ["Prudence", "Bénédicta", "Gloria", "Prisca", "Gisèle", "Christelle", "Nadège", "Victoire", "Espérance", "Carine"] }
      },
      "yoruba": {
        "given": {
