      "ewe": {
        "given": {
          "m": ["Kossi", "Kodjo", "Komlan", "Kokou", "Yao", "Koffi", "Komi", "Mawuli", "Edem", "Sena", "Elom", "Kafui", "Selom", "Dodzi", "Mensah", "Atsu"],
