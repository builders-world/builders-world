    "bm": {
      "hello": [["I ni ce", "Hello (to one person)"], ["Aw ni ce", "Hello (to several people)"]],
      "morning": [["I ni sɔgɔma", "Good morning"]],
      "evening": [["I ni wula", "Good evening (late afternoon)"], ["I ni su", "Good evening (after dark)"]],
      "how_are_you": [["I ka kɛnɛ wa?", "Are you well?"], ["Hɛrɛ tɛ?", "No trouble? All in peace?"], ["Somɔgɔw ka kɛnɛ wa?", "Is the family well?"]],
      "fine": [["Tɔɔrɔ si tɛ", "No trouble at all"], ["Hɛrɛ dɔrɔn", "Peace only"], ["N'ba", "Yes, thank you (a man's reply)"], ["N'se", "Yes, thank you (a woman's reply)"]],
      "thanks": [["I ni ce", "Thank you"], ["I ni baara", "Thanks for your work"]],
      "bye": [["K'an bɛn", "See you"], ["K'an bɛn sini", "See you tomorrow"], ["Ka su hɛrɛ caya", "Good night (may the night be peaceful)"]],
      "welcome": [["I bisimila", "Welcome"]],
      "sorry": [["Hakɛto", "Sorry, forgive me"]],
      "excuse": [["Hakɛto", "Excuse me"]],
      "yes": [["Ɔwɔ", "Yes"]],
      "no": [["Ayi", "No"]]
    },
